# The Elysium website (headless: no database, no admin panel). Every value here
# is read at run time except the two marked BUILD, which are read when the app
# is built (pass them as Docker build arguments). See docs/deploy-demo.md.

# --- the brand ERP ------------------------------------------------------------------------
# Where this server calls the ERP's storefront API: an origin only, no path.
# On the brands server the ERP API is published on loopback, so the site calls it
# there (no TLS hop, no Cloudflare in between, nothing leaves the machine):
ERP_API_URL=http://127.0.0.1:3501
# From the ERP console: Website → Connection → "Issue a key". The secret is shown
# once; keep it only here. Revoking the key there stops this site at once.
ERP_SITE_KEY_ID=pk_...
ERP_SITE_SECRET=sk_...
# Where /admin and /admin/* send staff (the ERP's console).
ERP_ADMIN_URL=https://erp.elysium-lifestyle.bd
# BUILD: the origin(s) the ERP's public product images come from (comma-separated):
# the ERP's API_PUBLIC_URL, or the CDN set as its STOREFRONT_MEDIA_BASE_URL.
ERP_MEDIA_ORIGINS=https://erp.elysium-lifestyle.bd

# --- this site ---------------------------------------------------------------------------
# BUILD: the site's public address (metadata, SSLCommerz return redirects).
NEXT_PUBLIC_SITE_URL=https://demo.elysium-lifestyle.bd
# next-auth (shopper sessions only; accounts live in the ERP).
NEXTAUTH_URL=https://demo.elysium-lifestyle.bd
# 32+ random bytes: openssl rand -base64 48
NEXTAUTH_SECRET=

# Google sign-in for shoppers (optional; the button shows only when both are set).
# An OAuth client whose authorised redirect URI is
#   https://demo.elysium-lifestyle.bd/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional fallback for the WhatsApp button when the ERP's Website → Settings has none.
NEXT_PUBLIC_WHATSAPP_NUMBER=
