# Database
MONGODB_URI=mongodb://localhost:27017/elysium

# NextAuth
NEXTAUTH_SECRET=your-random-secret-key-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000

# EnCDN media uploads (https://cdn.enfinito.cloud) — server-only secrets
CDN_API_KEY=cdn_your_api_key
CDN_API_SECRET=your_64_char_hex_secret

# SSLCommerz (Bangladesh payment gateway)
# Get credentials from: https://merchant.sslcommerz.com
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false

# Site URL (must be publicly accessible for SSLCommerz callbacks)
# Use ngrok for local development: ngrok http 3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number (with country code, no + symbol)
NEXT_PUBLIC_WHATSAPP_NUMBER=8801700000000
