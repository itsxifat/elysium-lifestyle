# Database
MONGODB_URI=mongodb://localhost:27017/elysium

# NextAuth
NEXTAUTH_SECRET=your-random-secret-key-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000

# EnCDN media uploads (https://cdn.enfinito.cloud) — server-only secrets
CDN_API_KEY=cdn_your_api_key
CDN_API_SECRET=your_64_char_hex_secret

# SSLCommerz (Bangladesh payment gateway)
# Get credentials from: https://merchant.sslcommerz.com
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false

# Site URL (must be publicly accessible for SSLCommerz callbacks)
# Use ngrok for local development: ngrok http 3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number (with country code, no + symbol)
NEXT_PUBLIC_WHATSAPP_NUMBER=8801700000000
FRAUDJS_SECRET=

# ncom.bd — live product source (contract 1)
#
# ncom does not store a copy of this catalogue. It reads /api/ncom/v1/* on this
# server, signing every request, so the credentials below are what let it in.
#
# You normally do NOT need any of these — configure it all at /admin/ncom
# instead, which stores them in the database and needs no redeploy. They still
# work and TAKE PRECEDENCE over whatever the panel has saved, which is useful
# for pinning a deployment to a specific key; the panel says when it is being
# overridden.

# INBOUND — issued by ncom under Settings → Product source, shown once.
NCOM_CONNECTOR_KEY=
NCOM_CONNECTOR_SECRET=

# OUTBOUND — a REST key from Developers → API keys, for reading orders and
# registering webhooks. ORDERS_READ + WEBHOOKS_READ/WRITE is enough; it needs no
# catalogue write scopes at all.
NCOM_API_KEY=
NCOM_WEBHOOK_SECRET=
# Optional base-URL override; defaults to https://ncom.bd/api/v1
NCOM_API_URL=

# The connector needs a public origin for the product URLs and image URLs it
# hands ncom's landing pages. NEXT_PUBLIC_SITE_URL above is used unless the
# "Public base URL" field at /admin/ncom is filled in, which overrides it.